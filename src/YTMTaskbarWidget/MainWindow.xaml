<Window x:Class="YTMTaskbarWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTM Taskbar Widget" Height="40" Width="340"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Top="1000" Left="500">
    <Window.Resources>
        <!-- Transparent circular icon button (prev / next) -->
        <Style x:Key="GlassIconButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#28FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Solid rounded play button -->
        <Style x:Key="GlassPlayButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#F2FFFFFF"/>
            <Setter Property="Foreground" Value="#FF1B1B1B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#66FFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="8" ShadowDepth="1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#D8FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Liquid glass pill (fits inside 48px taskbar, draggable along it) -->
    <Border x:Name="DragZone" CornerRadius="14" Padding="0" Cursor="SizeAll"
            PreviewMouseLeftButtonDown="DragZone_PreviewMouseLeftButtonDown"
            PreviewMouseMove="DragZone_PreviewMouseMove"
            PreviewMouseLeftButtonUp="DragZone_PreviewMouseLeftButtonUp">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#B2323232" Offset="0.0"/>
                <GradientStop Color="#A8262626" Offset="0.45"/>
                <GradientStop Color="#991D1D1D" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#59FFFFFF" Offset="0.0"/>
                <GradientStop Color="#1FFFFFFF" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="8" ShadowDepth="1"/>
        </Border.Effect>
        <Grid Margin="8,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Rounded thumbnail -->
            <Border Width="28" Height="28" CornerRadius="8" VerticalAlignment="Center"
                    Background="#33FFFFFF">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,28,28" RadiusX="8" RadiusY="8"/>
                </Border.Clip>
                <Image x:Name="Thumb" Width="28" Height="28" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                <TextBlock x:Name="TitleText" Text="Nothing playing" Foreground="White"
                           FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LyricText" Text="" Foreground="#D8FFFFFF"
                           FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevBtn" Content="&#xE100;" Style="{StaticResource GlassIconButton}"/>
                <Button x:Name="PlayBtn" Content="&#xE102;" Style="{StaticResource GlassPlayButton}" Margin="4,0"/>
                <Button x:Name="NextBtn" Content="&#xE101;" Style="{StaticResource GlassIconButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
