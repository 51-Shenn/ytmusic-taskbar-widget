<Window x:Class="YTMTaskbarWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTM Taskbar Widget" Height="48" Width="340"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" Top="1000" Left="500">
    <Window.Resources>
        <!-- Transparent circular icon button (prev / next) -->
        <Style x:Key="GlassIconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#28FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Solid rounded play button -->
        <Style x:Key="GlassPlayButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="#F2FFFFFF"/>
            <Setter Property="Foreground" Value="#FF1B1B1B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#66FFFFFF" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="8" ShadowDepth="1"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="#D8FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Liquid glass pill (fits inside 48px taskbar, draggable along it) -->
    <Border x:Name="DragZone" CornerRadius="10" Padding="0" Cursor="SizeAll"
            PreviewMouseLeftButtonDown="DragZone_PreviewMouseLeftButtonDown"
            PreviewMouseMove="DragZone_PreviewMouseMove"
            PreviewMouseLeftButtonUp="DragZone_PreviewMouseLeftButtonUp"
            PreviewMouseRightButtonDown="DragZone_PreviewMouseRightButtonDown">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#B2323232" Offset="0.0"/>
                <GradientStop Color="#A8262626" Offset="0.45"/>
                <GradientStop Color="#991D1D1D" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#59FFFFFF" Offset="0.0"/>
                <GradientStop Color="#1FFFFFFF" Offset="1.0"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.BorderThickness>1</Border.BorderThickness>
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="8" ShadowDepth="1"/>
        </Border.Effect>
        <Grid Margin="4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Rounded thumbnail -->
            <Border Width="32" Height="32" CornerRadius="10" VerticalAlignment="Center"
                    Background="#33FFFFFF">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,32,32" RadiusX="10" RadiusY="10"/>
                </Border.Clip>
                <Image x:Name="Thumb" Width="32" Height="32" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                <TextBlock x:Name="TitleText" Text="Nothing playing" Foreground="White"
                           FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="LyricText" Text="" Foreground="#FF9A9A9A"
                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevBtn" Style="{StaticResource GlassIconButton}">
                    <Path Data="M6 6h2v12H6V6zm3.5 6l8.5 6V6z" Fill="White"
                          Width="8" Height="8" Stretch="Uniform"
                          Stroke="White" StrokeThickness="1" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="PlayBtn" Style="{StaticResource GlassPlayButton}" Margin="4,0">
                    <Grid>
                        <Path x:Name="PlayGlyph" Data="M8 5v14l11-7z" Fill="#FF1B1B1B"
                              Width="10" Height="10" Stretch="Uniform"
                              Stroke="#FF1B1B1B" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path x:Name="PauseGlyph" Data="M6 5h4v14H6zM14 5h4v14h-4z" Fill="#FF1B1B1B"
                              Width="10" Height="10" Stretch="Uniform" Visibility="Collapsed"
                              Stroke="#FF1B1B1B" StrokeThickness="1" StrokeLineJoin="Round"/>
                    </Grid>
                </Button>
                <Button x:Name="NextBtn" Style="{StaticResource GlassIconButton}">
                    <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="White"
                          Width="8" Height="8" Stretch="Uniform"
                          Stroke="White" StrokeThickness="1" StrokeLineJoin="Round"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
