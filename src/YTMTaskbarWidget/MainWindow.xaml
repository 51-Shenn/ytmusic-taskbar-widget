<Window x:Class="YTMTaskbarWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YTM Taskbar Widget" Height="56" Width="352"
        WindowStyle="None" AllowsTransparency="True"
         Background="Transparent" Topmost="True" ShowInTaskbar="False"
         ResizeMode="NoResize" Top="1000" Left="500">
    <Window.Resources>
        <!-- Transparent circular icon button (prev / next) -->
        <Style x:Key="GlassIconButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="16"
                                Background="Transparent"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Solid rounded play button -->
        <Style x:Key="GlassPlayButton" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle" CornerRadius="18"
                                Background="Transparent"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillChrome" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#22FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#18FFFFFF" Offset="0.35"/>
                                <GradientStop Color="#0FFFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DragHandleChrome" TargetType="Border">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                    <Setter Property="Background" Value="#77FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Liquid glass pill (fits inside 48px taskbar, draggable along it) -->
    <Border x:Name="DragZone" Style="{StaticResource PillChrome}" CornerRadius="10" Padding="0" Margin="10,10,10,2"
            PreviewMouseLeftButtonDown="DragZone_PreviewMouseLeftButtonDown"
            PreviewMouseMove="DragZone_PreviewMouseMove"
            PreviewMouseLeftButtonUp="DragZone_PreviewMouseLeftButtonUp"
            PreviewMouseRightButtonDown="DragZone_PreviewMouseRightButtonDown">
        <Grid Margin="4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DragHandle" Grid.Column="0"
                    Width="10" Height="20"
                    VerticalAlignment="Center" Margin="-3,0,4,0"
                    Background="Transparent" Cursor="SizeAll">
                <Border Width="3" Height="16" CornerRadius="1.5"
                        Style="{StaticResource DragHandleChrome}"
                        VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>

            <!-- Dynamic-Island style soundwave (left of album art), centered on its axis -->
            <Grid Grid.Column="1" Width="18" Height="14" VerticalAlignment="Center"
                  Margin="6,0,12,0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="WaveBar0" Width="2" Height="2" CornerRadius="1"
                            Background="#FF30D158" Margin="1.5,0" VerticalAlignment="Center"/>
                    <Border x:Name="WaveBar1" Width="2" Height="2" CornerRadius="1"
                            Background="#FF30D158" Margin="1.5,0" VerticalAlignment="Center"/>
                    <Border x:Name="WaveBar2" Width="2" Height="2" CornerRadius="1"
                            Background="#FF30D158" Margin="1.5,0" VerticalAlignment="Center"/>
                    <Border x:Name="WaveBar3" Width="2" Height="2" CornerRadius="1"
                            Background="#FF30D158" Margin="1.5,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Rounded thumbnail -->
            <Border Grid.Column="2" Width="32" Height="32" CornerRadius="5" VerticalAlignment="Center"
                    Background="#33FFFFFF">
                <Border.Clip>
                    <RectangleGeometry Rect="0,0,32,32" RadiusX="5" RadiusY="5"/>
                </Border.Clip>
                <Image x:Name="Thumb" Width="32" Height="32" Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0">
                <Canvas x:Name="TitleClip" ClipToBounds="True" Height="16">
                    <TextBlock x:Name="TitleText" Text="Nothing playing" Foreground="White"
                                FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                Canvas.Left="0" Canvas.Top="0"/>
                </Canvas>
                <TextBlock x:Name="LyricText" Text="" Foreground="#FF9A9A9A"
                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PrevBtn" Style="{StaticResource GlassIconButton}">
                    <Path Data="M6 6h2v12H6V6zm3.5 6l8.5 6V6z" Fill="White"
                          Width="8" Height="8" Stretch="Uniform"
                          Stroke="White" StrokeThickness="1" StrokeLineJoin="Round"/>
                </Button>
                <Button x:Name="PlayBtn" Style="{StaticResource GlassPlayButton}" Margin="4,0">
                    <Grid>
                        <Path x:Name="PlayGlyph" Data="M8 5v14l11-7z" Fill="White"
                              Width="10" Height="10" Stretch="Uniform"
                              Stroke="White" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path x:Name="PauseGlyph" Data="M6 5h4v14H6zM14 5h4v14h-4z" Fill="White"
                              Width="10" Height="10" Stretch="Uniform" Visibility="Collapsed"
                              Stroke="White" StrokeThickness="1" StrokeLineJoin="Round"/>
                    </Grid>
                </Button>
                <Button x:Name="NextBtn" Style="{StaticResource GlassIconButton}">
                    <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="White"
                          Width="8" Height="8" Stretch="Uniform"
                          Stroke="White" StrokeThickness="1" StrokeLineJoin="Round"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
