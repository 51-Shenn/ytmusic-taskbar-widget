<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>YTMTaskbarWidget</AssemblyName>
    <RootNamespace>YTMTaskbarWidget</RootNamespace>
    <ApplicationIcon></ApplicationIcon>
    <Version>0.1.0</Version>
    <Authors>ytmusic-taskbar-widget</Authors>
    <Description>YouTube Music taskbar widget (SMTC + synced lyrics overlay).</Description>
  </PropertyGroup>

</Project>
